# Nunca versione a chave real. Copie este arquivo para .env.
OPENAI_API_KEY=

# O modo padrão não faz nenhuma chamada paga.
BRAIN_PROVIDER=local

# ASR aberto local promovido. Para reproduzir a baseline anterior:
# ASR_FINAL_ENGINE=whisper
# ASR_FINAL_MODEL=base
ASR_FINAL_ENGINE=parakeet
ASR_FINAL_MODEL=nemo-parakeet-tdt-0.6b-v3
ASR_PARTIAL_MODEL=tiny

# Evita publicar uma final muito rápida imediatamente antes de continuação ou
# correção. Ações potencialmente mutáveis recebem uma janela maior.
FINAL_COMMIT_GRACE_MS=220
EFFECTFUL_COMMIT_GRACE_MS=500
VAD_SHADOW=disabled
# Challenger explícito; mantenha energy como baseline até promoção.
# VAD_CONTROL=silero
SILERO_VAD_MODEL_PATH=eval/generated/vad/models/silero_vad_v6.2.onnx
SILERO_VAD_THRESHOLD=0.5
SILERO_VAD_ONSET_WINDOWS=2

# 0.025 é a baseline conservadora. Candidatos mais sensíveis precisam passar
# novamente pelo silêncio físico longo antes de promoção.
VAD_MIN_ON_THRESHOLD=0.025
VAD_ON_MULTIPLIER=4
VAD_ONSET_FRAMES=4

# Modelo rápido para o caminho conversacional.
OPENAI_INTERACTION_MODEL=gpt-5.6-luna

# Delegações também usam o modelo barato, salvo experimento explícito.
OPENAI_TASK_MODEL=gpt-5.6-luna

# Baseline de menor latência. Compare com low usando os mesmos traces.
OPENAI_REASONING_EFFORT=none
OPENAI_MAX_OUTPUT_TOKENS=160
OPENAI_MAX_REQUESTS_PER_PROCESS=25

# Premium exige as duas opções e recebe um teto rígido de 5 chamadas/processo:
# OPENAI_TASK_MODEL=gpt-5.6-sol
# OPENAI_ALLOW_PREMIUM=true
