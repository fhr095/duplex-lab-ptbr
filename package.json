{
  "name": "duplex-lab-ptbr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Laboratório orientado a avaliação para interação de voz full-duplex em português brasileiro.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "setup:asr": "uv venv --python 3.12 --allow-existing .venv && uv pip install --python .venv/bin/python -r requirements-asr.txt",
    "setup:vad": "node scripts/setup-silero-vad.mjs",
    "fetch:real-audio": ".venv/bin/python scripts/fetch_coraa_sample.py",
    "eval": "node src/cli/eval.mjs",
    "eval:index:check": "node src/eval/experiment-index.mjs",
    "eval:report": "node src/cli/eval.mjs --out eval/reports/baseline-v0.json",
    "eval:asr": "node scripts/eval-asr.mjs",
    "eval:asr:real": "npm run fetch:real-audio && node scripts/eval-asr.mjs --pack eval/generated/coraa/manifest.json --out eval/reports/asr-real-latest.json",
    "eval:asr:compare": "node scripts/compare-asr.mjs",
    "eval:perception": "node scripts/eval-perception.mjs",
    "eval:factory": "node scripts/build-eval-factory.mjs",
    "eval:factory:check": "node scripts/build-eval-factory.mjs --check",
    "eval:factory:audio": "node scripts/materialize-eval-factory-audio.mjs",
    "eval:factory:acoustics": "node scripts/materialize-eval-factory-acoustics.mjs",
    "eval:factory:acoustics:run": "node scripts/live-audio-campaign.mjs --pack eval/generated/factory/acoustic/live-audio-pack.json --out eval/reports/eval-factory-acoustic-live-latest.json --no-fail",
    "eval:factory:browser": "node scripts/run-eval-factory-browser.mjs",
    "eval:factory:browser:pcm": "node scripts/run-eval-factory-browser.mjs --input pcm",
    "eval:factory:browser:pcm:noise": "node scripts/run-eval-factory-browser.mjs --input pcm --acoustic-condition noise-10db",
    "eval:factory:summary": "node scripts/report-eval-factory.mjs",
    "eval:exp:0007:websocket": "node scripts/live-audio-campaign.mjs --pack eval/experiments/exp-0007-screening.pt-BR.json --repetitions 5 --out eval/reports/exp-0007-current-websocket.json --no-fail",
    "eval:exp:0007:browser": "node scripts/run-eval-factory-browser.mjs --input pcm --audio-overrides eval/experiments/exp-0007-browser-audio-overrides.json --case corr-amount-nao-barge-surface-a --case corr-time-na-verdade-cross-surface-a --case corr-weekday-quer-dizer-cross-surface-a --case corr-name-na-verdade-pause-surface-a --case corr-time-quer-dizer-barge-surface-a --repetitions 5 --out eval/reports/exp-0007-current-browser.json --no-fail",
    "eval:exp:0007:report": "node scripts/report-exp-0007.mjs",
    "eval:exp:0008": "node scripts/run-exp-0008-shadow.mjs",
    "eval:exp:0009:report": "node scripts/report-exp-0009-guard.mjs",
    "eval:exp:0010:browser": "REQUIRE_VAD_CONTROL=silero-vad REQUIRE_VAD_SHADOW=1 CRITICAL_CONFIRMATION_REPETITIONS=5 BROWSER_RUN_NONCE=exp-0010-current BROWSER_REPORT=eval/reports/exp-0010-browser-smoke-current.json node scripts/windows-chrome-smoke.mjs",
    "eval:exp:0010:report": "node scripts/report-exp-0010-kernel.mjs",
    "eval:exp:0011:control": "DUPLEX_URL='http://localhost:4173/?automation=1&audioReflex=immediate' REQUIRE_VAD_CONTROL=silero-vad REQUIRE_VAD_SHADOW=1 FALSE_ACTIVATION_PROBE_MS=5000 ALLOW_FAILED_GATES=1 BROWSER_RUN_NONCE=exp-0011-control-current BROWSER_REPORT=eval/reports/exp-0011-control-current.json node scripts/windows-chrome-smoke.mjs",
    "eval:exp:0011:candidate": "REQUIRE_VAD_CONTROL=silero-vad REQUIRE_VAD_SHADOW=1 FALSE_ACTIVATION_PROBE_MS=30000 ALLOW_FAILED_GATES=1 BROWSER_RUN_NONCE=exp-0011-candidate-current BROWSER_REPORT=eval/reports/exp-0011-candidate-current.json node scripts/windows-chrome-smoke.mjs",
    "eval:exp:0011:report": "node scripts/report-exp-0011-reflex.mjs",
    "eval:exp:0012:browser": "FALSE_ACTIVATION_PREFLIGHT_TIMEOUT_MS=5000 ALLOW_FAILED_GATES=1 REQUIRE_VAD_CONTROL=silero-vad REQUIRE_VAD_SHADOW=1 BROWSER_RUN_NONCE=exp-0012-candidate-current BROWSER_REPORT=eval/reports/exp-0012-browser-current.json node scripts/windows-chrome-smoke.mjs",
    "eval:exp:0012:report": "node scripts/report-exp-0012-lifecycle.mjs",
    "eval:exp:0013:browser": "FALSE_ACTIVATION_PREFLIGHT_TIMEOUT_MS=5000 ALLOW_FAILED_GATES=1 REQUIRE_VAD_CONTROL=silero-vad REQUIRE_VAD_SHADOW=1 BROWSER_RUN_NONCE=exp-0013-trace-current BROWSER_REPORT=eval/reports/exp-0013-browser-current.json node scripts/windows-chrome-smoke.mjs",
    "eval:exp:0013:report": "node scripts/report-exp-0013-training-trace.mjs",
    "eval:exp:0014:data": "node scripts/build-exp-0014-dataset.mjs",
    "eval:exp:0014:train": "node scripts/train-exp-0014-acoustic-reflex.mjs",
    "eval:exp:0014:browser": "FALSE_ACTIVATION_PREFLIGHT_TIMEOUT_MS=5000 ACOUSTIC_REFLEX_SHADOW_PROBE=1 ALLOW_FAILED_GATES=1 REQUIRE_VAD_CONTROL=silero-vad REQUIRE_VAD_SHADOW=1 BROWSER_RUN_NONCE=exp-0014-shadow-current BROWSER_REPORT=eval/reports/exp-0014-browser-current.json node scripts/windows-chrome-smoke.mjs",
    "eval:exp:0014:report": "node scripts/report-exp-0014-m4a.mjs",
    "eval:exp:0015:build": "node scripts/build-exp-0015-calibration-pack.mjs",
    "eval:exp:0015:check": "node scripts/build-exp-0015-calibration-pack.mjs --check",
    "eval:exp:0015:browser": "node scripts/smoke-exp-0015-calibration.mjs",
    "eval:exp:0015:report": "node scripts/report-exp-0015-calibration.mjs",
    "eval:exp:0015:serve": "node scripts/serve-exp-0015-calibration.mjs",
    "eval:exp:0016:source": "node scripts/fetch-exp-0016-fleurs-source.mjs",
    "eval:exp:0016:source:check": "node scripts/fetch-exp-0016-fleurs-source.mjs --check",
    "eval:exp:0016:data": "node scripts/build-exp-0016-speaker-relevance-dataset.mjs",
    "eval:exp:0016:data:check": "node scripts/build-exp-0016-speaker-relevance-dataset.mjs --check",
    "eval:exp:0016:train": "node scripts/train-exp-0016-speaker-relevance.mjs",
    "eval:exp:0016:train:check": "node scripts/train-exp-0016-speaker-relevance.mjs --check",
    "eval:exp:0016:report": "node scripts/report-exp-0016-speaker-relevance.mjs",
    "eval:exp:0016:report:check": "node scripts/report-exp-0016-speaker-relevance.mjs --check",
    "eval:exp:0016:browser": "node scripts/smoke-exp-0016-browser.mjs",
    "eval:exp:0017:supertonic": "node scripts/materialize-exp-0017-supertonic-sources.mjs",
    "eval:exp:0017:supertonic:check": "node scripts/materialize-exp-0017-supertonic-sources.mjs --check",
    "eval:exp:0017:data": "node scripts/build-exp-0017-core-dataset.mjs",
    "eval:exp:0017:data:check": "node scripts/build-exp-0017-core-dataset.mjs --check",
    "eval:exp:0017:core:dev": "node scripts/train-exp-0017-core-development.mjs",
    "eval:exp:0017:core:dev:check": "node scripts/train-exp-0017-core-development.mjs --check",
    "eval:exp:0017:r:prefixes": "node scripts/build-exp-0017-r-oracle-prefixes.mjs",
    "eval:exp:0017:r:prefixes:check": "node scripts/build-exp-0017-r-oracle-prefixes.mjs --check",
    "eval:exp:0018:data": "node scripts/build-exp-0018-context-datasets.mjs",
    "eval:exp:0018:data:check": "node scripts/build-exp-0018-context-datasets.mjs --check",
    "eval:baseline:freeze": "node scripts/freeze-runtime-baseline.mjs",
    "eval:live-audio": "node scripts/live-audio-probe.mjs",
    "eval:live-campaign": "node scripts/live-audio-campaign.mjs --no-fail",
    "eval:browser:campaign": "node scripts/browser-perception-campaign.mjs",
    "eval:vad:silero": ".venv/bin/python scripts/eval_silero_vad.py --manifest eval/scenarios/vad-candidate.pt-BR.json --out eval/reports/vad-candidate-ptbr-latest.json",
    "eval:vad:compare": "node scripts/compare-vad-control.mjs",
    "eval:asr:parakeet": "node scripts/eval-asr.mjs --engine parakeet --model nemo-parakeet-tdt-0.6b-v3",
    "eval:auto": "node scripts/autonomous-campaign.mjs",
    "eval:auto:deep": "AUTONOMOUS_DEEP=1 node scripts/autonomous-campaign.mjs",
    "eval:auto:silero": "AUTONOMOUS_VAD_CONTROL=silero node scripts/autonomous-campaign.mjs",
    "start": "BRAIN_PROVIDER=local VAD_CONTROL=silero VAD_SHADOW=silero SILERO_VAD_THRESHOLD=0.85 SILERO_VAD_ONSET_WINDOWS=1 node src/cli/serve.mjs",
    "start:energy-control": "BRAIN_PROVIDER=local VAD_CONTROL=energy VAD_SHADOW=disabled node src/cli/serve.mjs",
    "start:shadow": "npm run setup:vad && BRAIN_PROVIDER=local VAD_SHADOW=silero node src/cli/serve.mjs",
    "start:silero-candidate": "npm run setup:vad && npm start",
    "start:openai": "BRAIN_PROVIDER=openai node src/cli/serve.mjs",
    "probe:openai": "node scripts/openai-canary.mjs",
    "smoke:chrome": "node scripts/windows-chrome-smoke.mjs",
    "check": "npm test && npm run eval"
  },
  "dependencies": {
    "onnxruntime-node": "^1.27.0",
    "ws": "^8.21.1"
  },
  "overrides": {
    "adm-zip": "0.6.0"
  }
}
